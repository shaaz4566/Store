rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function isAdmin(){return request.auth != null && request.auth.uid == "ihSDHUk86DY8McVcLN7gjzt96Bm1";}
  match /public-images/{allPaths=**} {
    allow read: if true;
    allow write: if isAdmin() && request.resource != null && request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024;
    allow delete: if isAdmin();
  }

  match /image-host/{allPaths=**} {
    allow read: if true;
    allow write: if request.auth != null && request.resource != null && request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024;
    allow delete: if false;
  }

